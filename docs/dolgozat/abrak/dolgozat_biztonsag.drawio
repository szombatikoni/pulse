<mxfile host="app.diagrams.net">
  <diagram name="Biztonsági architektúra" id="sec">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1210" pageHeight="1000" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="compose" value="Docker Compose (belső hálózat)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;verticalAlign=top;align=left;spacing=8;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="270" y="20" width="930" height="965" as="geometry"/></mxCell>
        <mxCell id="zoneA" value="publikált port, csak a saját gépről (127.0.0.1) érhető el" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#2C4A6E;verticalAlign=top;align=left;spacing=8;fontSize=12;fontColor=#2C4A6E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="55" width="890" height="720" as="geometry"/></mxCell>
        <mxCell id="zoneB" value="csak a compose belső hálózatán (nincs ports bejegyzés)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;verticalAlign=bottom;align=left;spacing=8;fontSize=12;fontColor=#555555;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="800" width="890" height="165" as="geometry"/></mxCell>
        <mxCell id="browser" value="&lt;b&gt;Böngésző&lt;/b&gt; (React SPA)&lt;br&gt;token: sessionStorage&lt;br&gt;minden kérésnél:&lt;br&gt;Authorization: Bearer …&lt;br&gt;401 után: token törlése,&lt;br&gt;vissza a Belépésre" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2C4A6E;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="85" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Megjegyzések&lt;/b&gt;&lt;br&gt;Token nélkül csak a belépés&lt;br&gt;(POST /api/auth/login), a /api/health&lt;br&gt;és az API-leírás érhető el.&lt;br&gt;A szerepkör nincs a tokenben: a&lt;br&gt;szerver minden kérésnél az&lt;br&gt;adatbázisból olvassa.&lt;br&gt;A felület csak megjelenít; minden&lt;br&gt;döntés a backendben születik." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F9;strokeColor=#888888;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="220" height="160" as="geometry"/></mxCell>
        <mxCell id="fe" value="&lt;b&gt;frontend&lt;/b&gt; (nginx)&lt;br&gt;127.0.0.1:8080 → 80&lt;br&gt;location /api/ → api:8000&lt;br&gt;más útvonal: index.html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2C4A6E;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="db" value="&lt;b&gt;db&lt;/b&gt; (PostgreSQL 17)&lt;br&gt;127.0.0.1:5432" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#FFFFFF;strokeColor=#2C4A6E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="600" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;api&lt;/b&gt; (FastAPI), 127.0.0.1:8000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2C4A6E;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="90" width="570" height="670" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;1. HTTPBearer&lt;/b&gt; (api/deps.py)&lt;br&gt;van-e Bearer token a fejlécben?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F9;strokeColor=#2C4A6E;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="610" y="130" width="330" height="62" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. decode_access_token&lt;/b&gt; (core/security.py)&lt;br&gt;HS256-aláírás, lejárat (exp), sub" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F9;strokeColor=#2C4A6E;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="610" y="222" width="330" height="62" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. get_current_user&lt;/b&gt;&lt;br&gt;felhasználó betöltése az adatbázisból,&lt;br&gt;is_active ellenőrzése" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F9;strokeColor=#2C4A6E;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="610" y="314" width="330" height="70" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. require_roles&lt;/b&gt;&lt;br&gt;a végpont szerepköre:&lt;br&gt;PatientUser / DoctorUser / AdminUser" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F9;strokeColor=#2C4A6E;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="610" y="414" width="330" height="70" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;5. ensure_patient_access&lt;/b&gt;&lt;br&gt;can_access_patient (services/access.py)&lt;br&gt;beteg: csak a saját profilja&lt;br&gt;orvos: most érvényes DoctorPatient&lt;br&gt;admin: betegadatot nem ér el" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F9;strokeColor=#2C4A6E;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="610" y="514" width="330" height="104" as="geometry"/></mxCell>
