# Másold .env néven, ha a docker-compose alapértékeitől eltérő beállítást
# szeretnél. A .env fájl nem kerül a repóba.
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse

# A tokenek aláírókulcsa. Nyilvános környezetben kötelező lecserélni egy hosszú
# véletlen értékre, pl.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me-0123456789
# A bejelentkezés érvényessége percben.
ACCESS_TOKEN_EXPIRE_MINUTES=60
